#!/bin/sh
set -eu

chmod 0755 /usr/local/bin/playos-core-wayland-session
chmod 0755 /usr/local/sbin/playos-installer

printf '%s\n' 'PlayOS Live — Ubuntu Noble — XFCE profile over desktop-neutral Graphics Core' > /etc/issue

systemctl set-default graphical.target
systemctl enable lightdm.service
systemctl enable NetworkManager.service

update-mime-database /usr/share/mime
update-desktop-database /usr/share/applications || true
fc-cache -f
