#!/bin/sh
set -eu

lb config noauto \
  --mode debian \
  --architectures amd64 \
  --distribution trixie \
  --archive-areas "main contrib non-free-firmware" \
  --mirror-bootstrap https://deb.debian.org/debian/ \
  --mirror-chroot https://deb.debian.org/debian/ \
  --mirror-binary https://deb.debian.org/debian/ \
  --security true \
  --updates true \
  --binary-images iso-hybrid \
  --bootloaders "grub-pc grub-efi" \
  --debian-installer none \
  --initramfs live-boot \
  --initsystem systemd \
  --linux-packages linux-image \
  --linux-flavours 6.8.0-138-generic \
  --apt-recommends true \
  --memtest none \
  --iso-application "PlayOS Debian XFCE Noble Kernel" \
  --iso-publisher "PlayOS Project" \
  --iso-volume "PLAYOS_D13_XFCE" \
  --bootappend-live "boot=live components username=playos hostname=playos locales=pt_BR.UTF-8 keyboard-layouts=br" \
  "${@}"
