{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playos://schema/qa-example",
  "title": "PlayOS supervised QA example",
  "type": "object",
  "required": ["id", "question", "answer", "source_ids", "expected_behavior", "split"],
  "properties": {
    "id": {"type": "string", "pattern": "^QA-[A-Z0-9-]+$"},
    "question": {"type": "string", "minLength": 8},
    "answer": {"type": "string", "minLength": 10},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
    "expected_behavior": {"enum": ["answer", "compare", "correct-premise", "refuse-unsupported", "state-unknown"]},
    "split": {"enum": ["train", "validation", "adversarial", "evaluation"]},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
