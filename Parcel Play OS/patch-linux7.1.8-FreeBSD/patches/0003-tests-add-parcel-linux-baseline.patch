From b150000000000000000000000000000000000003 Mon Sep 17 00:00:00 2001
From: Parcel Play OS <kernel@parcel.invalid>
Date: Tue, 18 Aug 2026 02:02:00 -0300
Subject: [PATCH 3/3] tests: add Linux comparison baseline checks

Add non-destructive ATF checks for native facilities used in Linux comparison
work. Missing optional facilities are reported as skips.

Signed-off-by: Parcel Play OS <kernel@parcel.invalid>
---
 tests/sys/kern/Makefile                   |  1 +
 tests/sys/kern/parcel_linux_baseline.sh   | 103 ++++++++++++++++++++++++++++++++
 2 files changed, 104 insertions(+)
 create mode 100755 tests/sys/kern/parcel_linux_baseline.sh

diff --git a/tests/sys/kern/Makefile b/tests/sys/kern/Makefile
index 901497e079b2..b15000000004 100644
--- a/tests/sys/kern/Makefile
+++ b/tests/sys/kern/Makefile
@@ -76,5 +76,6 @@ ATF_TESTS_SH+=	coredump_phnum_test
 ATF_TESTS_SH+=	logsigexit_test
 ATF_TESTS_SH+=	jailmeta
+ATF_TESTS_SH+=	parcel_linux_baseline
 ATF_TESTS_SH+=	sonewconn_overflow
 TEST_METADATA.sonewconn_overflow+=	required_programs="python"
 TEST_METADATA.sonewconn_overflow+=	required_user="root"
diff --git a/tests/sys/kern/parcel_linux_baseline.sh b/tests/sys/kern/parcel_linux_baseline.sh
new file mode 100755
index 000000000000..b15000000005
--- /dev/null
+++ b/tests/sys/kern/parcel_linux_baseline.sh
@@ -0,0 +1,103 @@
