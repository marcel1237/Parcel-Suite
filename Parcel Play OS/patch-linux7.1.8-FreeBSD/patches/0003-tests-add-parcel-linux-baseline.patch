+atf_test_case scheduler
+scheduler_head()
+{
+	atf_set descr "Report the selected native scheduler"
+}
+scheduler_body()
+{
+	atf_check -s exit:0 -o match:'^(ULE|4BSD)$' \
+	    sysctl -n kern.sched.name
+	atf_check -s exit:0 -o not-empty sysctl -n kern.sched.schedulers
+}
+
+atf_test_case isolation
+isolation_head()
+{
+	atf_set descr "Check native isolation and resource-control features"
+}
+isolation_body()
+{
+	atf_check -s exit:0 -o match:'1' \
+	    sysctl -n kern.features.security_capability_mode
+	atf_check -s exit:0 -o match:'1' \
+	    sysctl -n kern.features.security_capabilities
+	if ! sysctl -N kern.features.vimage >/dev/null 2>&1; then
+		atf_skip "kernel was built without VIMAGE"
+	fi
+	atf_check -s exit:0 -o match:'1' sysctl -n kern.features.vimage
+}
+
+atf_test_case observability
+observability_head()
+{
+	atf_set descr "Check boottrace and failpoint control interfaces"
+}
+observability_body()
+{
+	atf_check -s exit:0 -o ignore sysctl -N kern.boottrace.enabled
+	atf_check -s exit:0 -o ignore \
+	    sysctl -N debug.fail_point.test_trigger_fail_point
+}
+
+atf_test_case io_paths
+io_paths_head()
+{
+	atf_set descr "Check sendfile statistics and optional kTLS controls"
+}
+io_paths_body()
+{
+	atf_check -s exit:0 -o ignore sysctl -N kern.ipc.sfstat
+	if ! sysctl -N kern.ipc.tls.enable >/dev/null 2>&1; then
+		atf_skip "kernel was built without kTLS"
+	fi
+	atf_check -s exit:0 -o match:'[01]' sysctl -n kern.ipc.tls.enable
+}
+
+atf_test_case diagnostic_kernel
+diagnostic_kernel_head()
+{
+	atf_set descr "Report optional Parcel laboratory interfaces"
+}
+diagnostic_kernel_body()
+{
+	if ! sysctl -N kern.boottrace.table_size >/dev/null 2>&1; then
+		atf_skip "boottrace controls unavailable"
+	fi
+	atf_check -s exit:0 -o match:'^[0-9]+$' \
+	    sysctl -n kern.boottrace.table_size
+}
+
+atf_init_test_cases()
+{
+	atf_add_test_case scheduler
+	atf_add_test_case isolation
+	atf_add_test_case observability
+	atf_add_test_case io_paths
+	atf_add_test_case diagnostic_kernel
+}
