diff --git a/tools/testing/selftests/parcel_freebsd/parcel_features.sh b/tools/testing/selftests/parcel_freebsd/parcel_features.sh
new file mode 100755
index 000000000000..718000000005
--- /dev/null
+++ b/tools/testing/selftests/parcel_freebsd/parcel_features.sh
@@ -0,0 +1,61 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+
+echo "TAP version 13"
+echo "1..8"
+
+if [ -d /sys/kernel/tracing ] || [ -d /sys/kernel/debug/tracing ]; then
+        echo "ok 1 - tracing filesystem is available"
+else
+        echo "ok 1 - tracing filesystem is not mounted # SKIP"
+fi
+
+if [ -r /proc/cgroups ]; then
+        echo "ok 2 - cgroup interface is available"
+else
+        echo "not ok 2 - cgroup interface is unavailable"
+fi
+
+if [ -e /proc/self/ns/user ] && [ -e /proc/self/ns/net ]; then
+        echo "ok 3 - namespace handles are available"
+else
+        echo "not ok 3 - namespace handles are unavailable"
+fi
+
+if [ -r /proc/sys/kernel/unprivileged_bpf_disabled ]; then
+        value=$(cat /proc/sys/kernel/unprivileged_bpf_disabled)
+        echo "ok 4 - unprivileged BPF policy is visible ($value)"
+else
+        echo "ok 4 - unprivileged BPF policy unavailable # SKIP"
+fi
+
+if [ -e /sys/kernel/sched_ext/state ]; then
+        state=$(cat /sys/kernel/sched_ext/state)
+        echo "ok 5 - sched_ext interface is available ($state)"
+else
+        echo "ok 5 - sched_ext interface unavailable # SKIP configuration"
+fi
+
+if [ -e /dev/ntsync ]; then
+        echo "ok 6 - NTSYNC device is available"
+else
+        echo "ok 6 - NTSYNC device unavailable # SKIP module/configuration"
+fi
+
+if grep -qw tls /proc/modules 2>/dev/null; then
+        echo "ok 7 - kTLS module is loaded"
+elif [ -d /sys/module/tls ]; then
+        echo "ok 7 - kTLS is present"
+else
+        echo "ok 7 - kTLS is not loaded # SKIP"
+fi
+
+if [ -d /sys/kernel/debug/fail_function ] || \
+   [ -d /sys/kernel/debug/failslab ] || \
+   [ -d /sys/kernel/debug/fail_page_alloc ]; then
+        echo "ok 8 - fault injection interface is present"
+else
+        echo "ok 8 - fault injection interface absent # SKIP lab-only"
+fi
+
+exit 0
diff --git a/tools/testing/selftests/parcel_freebsd/parcel_sendfile.c b/tools/testing/selftests/parcel_freebsd/parcel_sendfile.c
new file mode 100644
index 000000000000..718000000006
--- /dev/null
+++ b/tools/testing/selftests/parcel_freebsd/parcel_sendfile.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/sendfile.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define TEST_SIZE 16384
+
+static int fail(const char *operation)
+{
+        fprintf(stderr, "not ok 1 - %s: %s\n", operation, strerror(errno));
+        return 1;
+}
+
+int main(void)
+{
+        unsigned char source[TEST_SIZE];
+        unsigned char received[TEST_SIZE];
+        char path[] = "/tmp/parcel-sendfile-XXXXXX";
+        size_t done = 0;
+        off_t offset = 0;
+        int sockets[2] = { -1, -1 };
+        int file = -1;
+        ssize_t ret;
+        size_t i;
+
+        puts("TAP version 13");
+        puts("1..1");
+        for (i = 0; i < TEST_SIZE; i++)
+                source[i] = (unsigned char)((i * 31U + 7U) & 0xffU);
+
+        file = mkstemp(path);
+        if (file < 0)
+                return fail("mkstemp");
+        unlink(path);
+        ret = write(file, source, sizeof(source));
+        if (ret != (ssize_t)sizeof(source)) {
+                close(file);
+                return fail("write source");
+        }
+        if (socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) < 0) {
+                close(file);
+                return fail("socketpair");
+        }
+
+        ret = sendfile(sockets[0], file, &offset, sizeof(source));
+        if (ret != (ssize_t)sizeof(source)) {
+                close(sockets[0]);
+                close(sockets[1]);
+                close(file);
+                return fail("sendfile");
+        }
+        while (done < sizeof(received)) {
+                ret = read(sockets[1], received + done,
+                           sizeof(received) - done);
+                if (ret <= 0) {
+                        close(sockets[0]);
+                        close(sockets[1]);
+                        close(file);
+                        return fail("read socket");
+                }
+                done += (size_t)ret;
+        }
+
+        close(sockets[0]);
+        close(sockets[1]);
+        close(file);
+        if (memcmp(source, received, sizeof(source)) != 0) {
+                errno = EIO;
+                return fail("data comparison");
+        }
+        puts("ok 1 - sendfile preserves data over an AF_UNIX socket");
+        return 0;
+}
