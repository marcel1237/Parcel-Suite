From 823021f6343196f30a60d09b24e298d0be001005 Mon Sep 17 00:00:00 2001
From: PlayOS Kernel Lab <kernel@playos.invalid>
Date: Tue, 18 Aug 2026 01:05:00 -0300
Subject: [PATCH] efi: libstub: build x86 sources as GNU11

The x86 EFI stub replaces the global KBUILD_CFLAGS and loses -std=gnu11.
GCC 15 defaults to C23, conflicting with Linux 6.8 bool definitions.  Restore
the kernel language standard explicitly for the x86 stub.

Signed-off-by: PlayOS Kernel Lab <kernel@playos.invalid>
---
 drivers/firmware/efi/libstub/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/firmware/efi/libstub/Makefile b/drivers/firmware/efi/libstub/Makefile
index b5102a7cc73c..9f3427f0db15 100644
--- a/drivers/firmware/efi/libstub/Makefile
+++ b/drivers/firmware/efi/libstub/Makefile
@@ -11,7 +11,7 @@ cflags-y			:= $(KBUILD_CFLAGS)
 cflags-$(CONFIG_X86_32)		:= -march=i386
 cflags-$(CONFIG_X86_64)		:= -mcmodel=small
-cflags-$(CONFIG_X86)		+= -m$(BITS) -D__KERNEL__ \
+cflags-$(CONFIG_X86)		+= -std=gnu11 -m$(BITS) -D__KERNEL__ \
 				   -fPIC -fno-strict-aliasing -mno-red-zone \
 				   -mno-mmx -mno-sse -fshort-wchar \
 				   -Wno-pointer-sign \
-- 
