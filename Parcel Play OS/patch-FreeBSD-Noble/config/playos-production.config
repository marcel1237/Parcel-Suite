# PlayOS Noble production intent. Reconcile through Ubuntu annotations before use.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_TLS=m
CONFIG_TLS_DEVICE=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_TRACEPOINTS=y
CONFIG_PSI=y
CONFIG_BOOT_CONFIG=y
CONFIG_KPROBES=y
CONFIG_BPF_SYSCALL=y

# Never enable destructive laboratory facilities in production by this file.
# CONFIG_FAULT_INJECTION is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_KCOV is not set
