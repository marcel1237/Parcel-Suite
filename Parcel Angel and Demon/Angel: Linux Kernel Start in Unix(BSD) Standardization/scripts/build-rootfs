#!/bin/bash
# ==============================================================================
# Angel OS Build System — Módulo: rootfs (Bootstrap Debian Trixie via debootstrap)
# ==============================================================================

set -e

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
PROJECT_ROOT=$(cd -- "$SCRIPT_DIR/.." &>/dev/null && pwd)
BUILD_ROOTFS="$PROJECT_ROOT/build/rootfs"

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

echo -e "${CYAN}>> [rootfs] Executando bootstrap do Debian Trixie em $BUILD_ROOTFS...${NC}"

if ! command -v debootstrap &>/dev/null; then
    echo -e "${RED}[X] Ferramenta 'debootstrap' não encontrada no host.${NC}"
    echo "Instale com: sudo apt install debootstrap"
    exit 1
fi

mkdir -p "$BUILD_ROOTFS"

if [ ! -f "$BUILD_ROOTFS/etc/debian_version" ]; then
    echo -e "${YELLOW}Iniciando debootstrap do Debian Trixie (exige privilégios sudo)...${NC}"
    sudo debootstrap --arch=amd64 --include=sudo,locales,ca-certificates trixie "$BUILD_ROOTFS" https://deb.debian.org/debian/
else
    echo -e "${GREEN}[OK] Debian Trixie já bootstrapado em $BUILD_ROOTFS${NC}"
fi

# Configurar apt sources.list
sudo tee "$BUILD_ROOTFS/etc/apt/sources.list" > /dev/null << 'EOF'
deb https://deb.debian.org/debian/ trixie main contrib non-free-firmware
deb https://deb.debian.org/debian-security/ trixie-security main contrib non-free-firmware
deb https://deb.debian.org/debian/ trixie-updates main contrib non-free-firmware
EOF

echo "angelos" | sudo tee "$BUILD_ROOTFS/etc/hostname" > /dev/null

echo -e "${GREEN}[OK] RootFS Debian Trixie pronto e configurado.${NC}"
