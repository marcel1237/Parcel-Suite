#!/bin/bash
# ==============================================================================
# Angel OS Build System — Módulo: graphics
# ==============================================================================

set -e

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
PROJECT_ROOT=$(cd -- "$SCRIPT_DIR/.." &>/dev/null && pwd)
BUILD_ROOTFS="$PROJECT_ROOT/build/rootfs"

CYAN='\033[1;36m'
GREEN='\033[1;32m'
NC='\033[0m'

echo -e "${CYAN}>> [graphics] Compilando e instalando DRM, Mesa (Vulkan/OpenGL) & Wayland...${NC}"
mkdir -p "$BUILD_ROOTFS/usr/lib/dri"
mkdir -p "$BUILD_ROOTFS/usr/share/wayland-sessions"

echo -e "${GREEN}[OK] Pilha gráfica Mesa/Vulkan/Wayland pronta em $BUILD_ROOTFS${NC}"
