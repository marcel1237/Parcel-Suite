#!/bin/bash
# ==============================================================================
# ANGEL OS BUILD SYSTEM — CLI Orquestrador Mestre
# ==============================================================================

set -e

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
SCRIPTS_DIR="$PROJECT_ROOT/scripts"

GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

echo -e "${CYAN}============================================================${NC}"
echo -e "${CYAN}                ANGEL OS BUILD SYSTEM v0.1.0                ${NC}"
echo -e "${CYAN}               \"Build Próprio + Componentes Upstream\"       ${NC}"
echo -e "${CYAN}============================================================${NC}"

source "$PROJECT_ROOT/config/kernel/kernel-7.3.conf" 2>/dev/null || true
source "$PROJECT_ROOT/config/iso/iso.conf" 2>/dev/null || true

echo -e "\n${YELLOW}Configurações de Build:${NC}"
echo -e "  - Target: ${GREEN}${ISO_NAME:-Angel-OS-KDE-Full} ${ISO_VERSION:-1.0.0}${NC}"
echo -e "  - Kernel: ${GREEN}${KERNEL_NAME:-Seraphin} (${KERNEL_VERSION:-7.3.0-vanilla})${NC}"
echo -e "  - Output ISO: ${GREEN}${PROJECT_ROOT}/output/${ISO_NAME:-Angel-OS-KDE-Full}.iso${NC}"

show_usage() {
    echo -e "\n${CYAN}Uso:${NC} ./angel-build [subcomando]"
    echo -e "\n${YELLOW}Subcomandos Disponíveis:${NC}"
    echo -e "  all          Executa todo o pipeline de build do Angel OS em sequência"
    echo -e "  toolchain    Constrói/prepara o ambiente da Toolchain base"
    echo -e "  rootfs       Inicializa o layout FHS e diretórios do Angel RootFS"
    echo -e "  kernel       Compila o Kernel Linux Vanilla 7.3 (Seraphin)"
    echo -e "  system       Instala o systemd, udev, dbus e serviços de sistema"
    echo -e "  graphics     Instala DRM, Mesa (Vulkan/OpenGL) e Wayland"
    echo -e "  kde          Instala Qt 6, KDE Frameworks, KWin, Plasma 6 e SDDM"
    echo -e "  initramfs    Gera a imagem do initramfs próprio do Angel OS"
    echo -e "  iso          Compacta o RootFS em SquashFS e gera a ISO híbrida"
    echo -e "  qemu         Inicia o teste de boot no QEMU/KVM"
    echo -e "  --check      Verifica as ferramentas e pré-requisitos do host"
    echo -e "  --help       Exibe esta ajuda"
}

run_step() {
    local step_script="$SCRIPTS_DIR/build-$1"
    if [ -x "$step_script" ]; then
        "$step_script"
    else
        echo -e "${RED}[X] Erro: Script $step_script não encontrado ou sem permissão de execução.${NC}"
        exit 1
    fi
}

case "$1" in
    all)
        echo -e "\n${YELLOW}Iniciando Build Completo do Angel OS KDE-Full...${NC}"
        run_step "toolchain"
        run_step "rootfs"
        run_step "kernel"
        run_step "system"
        run_step "graphics"
        run_step "kde"
        run_step "initramfs"
        run_step "iso"
        echo -e "\n${GREEN}============================================================${NC}"
        echo -e "${GREEN}  Angel OS KDE-Full gerado com sucesso em output/!           ${NC}"
        echo -e "${GREEN}============================================================${NC}"
        ;;
    toolchain)
        run_step "toolchain"
        ;;
    rootfs)
        run_step "rootfs"
        ;;
    kernel)
        run_step "kernel"
        ;;
    system)
        run_step "system"
        ;;
    graphics)
        run_step "graphics"
        ;;
    kde)
        run_step "kde"
        ;;
    initramfs)
        run_step "initramfs"
        ;;
    iso)
        run_step "iso"
        ;;
    qemu)
        "$SCRIPTS_DIR/run_qemu.sh"
        ;;
    --check)
        "$SCRIPTS_DIR/bootstrap_env.sh"
        ;;
    "")
        show_usage
        ;;
    *)
        show_usage
        ;;
esac
